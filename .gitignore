# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
._*
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code: share project settings, keep personal files local
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Claude Code personal settings
.claude/settings.local.json

# Secrets and credentials (CI uses GitHub secrets instead)
.env
.env.*
*.pem
*.key
*service-account*.json
*serviceAccount*.json

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/

# Firebase – this is necessary if you use Firebase since it could otherwise
# lead to leaking of private certificates to your repository, which is no bueno.
.firebase/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Native platform folders. This is a web-only project, but Flutter tooling
# (e.g. IDE pub get) can regenerate these with machine-specific files.
/android/
/ios/

# FVM Version Cache (.fvmrc is committed, the local SDK symlinks are not)
.fvm/
